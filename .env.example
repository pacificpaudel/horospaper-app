# --- App data (24h TTL, guest-only) ---
# Upstash Redis REST credentials (provision via the "Upstash for Redis" Vercel
# Marketplace integration, which injects these as KV_REST_API_URL/TOKEN).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Geocoding ---
# Free, no key required: OpenStreetMap Nominatim is used by default.
# Set GEOCODE_USER_AGENT to something identifying your app per Nominatim usage policy.
GEOCODE_USER_AGENT="horospaper-dev/1.0"

# --- LLM (horoscope text, rashifal/Panchang interpretation) ---
# Set any of these. LLM_PROVIDER (if set) is tried first; every other
# configured provider is then tried in order (anthropic -> openai ->
# gemini) if an earlier one is missing, expired, or out of credit -- so
# one broken key doesn't silently fall all the way back to the
# deterministic template generator (clearly logged as MOCK mode) while a
# working key sits unused. GEMINI_API_KEY is a free Google AI Studio key
# (aistudio.google.com, no credit card) -- Gemini's OpenAI-compatible
# endpoint, so no separate SDK is needed.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
LLM_PROVIDER="anthropic" # "anthropic" | "openai" | "gemini" | "mock"

# --- Birth chart (sign shown in the birth-profile form) ---
# freeastrologyapi.com key (free plan: 50 requests/day). Results are cached
# per birth input; without a key the form uses its own local calculation.
FREE_ASTROLOGY_API_KEY=""

# --- Panchang + daily luck (a *different* service, freeastroapi.com) ---
# Free plan: 80 requests/day, 1 request/second. Used for today's exact
# Panchang (tithi/nakshatra/yoga/karana/rahu kalam), which an LLM then
# interprets -- never calculated or guessed by the LLM itself. Shared per
# (date, location), not per-person, so it stays well within the free plan.
# Without a key, the daily luck score/tags fall back to planets + rashifal only.
FREEASTRO_API_KEY=""

# --- Image generation ---
# If unset, a procedural SVG "cosmic portrait" is generated locally instead
# of calling an external image API (MOCK mode).
IMAGE_PROVIDER="mock" # "openai" | "mock"
# OPENAI_API_KEY is reused for image generation when IMAGE_PROVIDER="openai"

# --- Storage ---
# "local" stores generated images under /public/generated and serves them
# directly from Next.js -- works locally, but Vercel's serverless functions
# have a read-only filesystem, so production uses "vercel-blob" instead.
# Provision via `vercel blob create-store <name> --access public`.
STORAGE_PROVIDER="local" # "local" | "vercel-blob"
BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting ---
FREE_GENERATIONS_PER_DAY="1"
# Local development only: bypass daily generation limits.
DISABLE_USAGE_LIMITS="false"
