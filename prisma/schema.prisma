generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AstrologySystem {
  WESTERN
  VEDIC
}

enum Language {
  EN
  NE
  FI
}

enum ImageStyle {
  COSMIC
  MINIMAL
  MYSTICAL
  WATERCOLOR
  RENAISSANCE
  MODERN_CELESTIAL
  DARK_SPACE
  DREAMY
  ABSTRACT
  MIXED_MEDIA
}

enum AuthProvider {
  GUEST
  GOOGLE
  CREDENTIALS
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  passwordHash  String?
  provider      AuthProvider @default(GUEST)
  isGuest       Boolean      @default(true)
  role          String       @default("user") // "user" | "admin"
  disabled      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  birthProfile     BirthProfile?
  horoscopes       Horoscope[]
  generationUsages GenerationUsage[]
  accounts         Account[]
  sessions         Session[]
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BirthProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  name            String?
  birthDate       DateTime // date only, stored at midnight UTC
  birthTime       String // "HH:mm" local time at birth location
  birthLocation   String
  latitude        Float
  longitude       Float
  timezone        String // IANA tz name, e.g. "Asia/Kathmandu"
  astrologySystem AstrologySystem @default(WESTERN)
  language        Language        @default(EN)
  imageStyle      ImageStyle      @default(COSMIC)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Horoscope {
  id             String     @id @default(cuid())
  userId         String
  generationDate DateTime // date only, the day this horoscope is for
  astrologyData  Json // structured natal + transit + today data sent to the LLM
  horoscopeText  Json // structured sections: overall, love, career, money, energy, focus, motivation
  imageUrl       String?
  imageStyle     ImageStyle @default(COSMIC)
  imagePrompt    String?    @db.Text
  isPreview      Boolean    @default(false) // true for "tomorrow's preview"
  error          String?    @db.Text
  createdAt      DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, generationDate, isPreview])
  @@index([userId, generationDate])
}

model GenerationUsage {
  id              String   @id @default(cuid())
  userId          String
  generationDate  DateTime // date only
  generationCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, generationDate])
}

model GeocodeCache {
  id        String   @id @default(cuid())
  query     String   @unique
  latitude  Float
  longitude Float
  timezone  String
  label     String
  createdAt DateTime @default(now())
}

model PlanetaryDataCache {
  id        String   @id @default(cuid())
  date      DateTime @unique // date only, UTC midnight
  data      Json // Sun/Moon/planet positions, moon phase, retrogrades for that date
  createdAt DateTime @default(now())
}

model GenerationError {
  id        String   @id @default(cuid())
  userId    String?
  stage     String // "astrology" | "geocode" | "llm" | "image" | "unknown"
  message   String   @db.Text
  createdAt DateTime @default(now())
}
